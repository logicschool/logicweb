NODE_ENV=production
PORT=8080
HOST=127.0.0.1
PUBLIC_ORIGIN=https://site.logiceducation.org
DATABASE_URL=postgres://logic:CHANGE_ME@127.0.0.1:5432/logic
PGSSL=false
# Set to 1 ONLY if precisely one trusted reverse proxy is in front of Node.
TRUST_PROXY=1
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
TOTP_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# Secrets override protected integration configuration. Keep out of Git.
ODOO_API_KEY=
CRM_WEBHOOK_SECRET=
# Set temporarily for npm run admin:create, then remove ADMIN_PASSWORD.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
