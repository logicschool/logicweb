[Unit]
Description=Logic School Website and CMS
After=network.target postgresql.service
[Service]
Type=simple
User=logic
Group=logic
WorkingDirectory=/srv/logic
EnvironmentFile=/srv/logic/.env
ExecStart=/usr/bin/node /srv/logic/server/app.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
[Install]
WantedBy=multi-user.target
