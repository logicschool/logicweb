# Merge into your existing HTTPS virtual host. Keep your working certificate directives.
# Node must remain bound to localhost. One reverse proxy => TRUST_PROXY=1.
server {
    listen 443 ssl;
    server_name site.logiceducation.org;
    # ssl_certificate /etc/letsencrypt/live/site.logiceducation.org/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/site.logiceducation.org/privkey.pem;
    # Images are sent as base64 JSON: 20 MB becomes roughly 27 MB.
    client_max_body_size 45m;
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 60s;
    }
}
server {
    listen 80;
    server_name site.logiceducation.org;
    return 301 https://$host$request_uri;
}
